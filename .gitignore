# Ignore everything at the repo root by default
/*

# ...except what we want in the repo
!/.gitignore
!/.github/
!/public/
!/blog-feed/

# Never commit these, anywhere
.wrangler/
node_modules/
.env
.dev.vars
*.sql
*.bak

# ...but migrations are schema files and should be versioned
!/blog-feed/migrations/*.sql
